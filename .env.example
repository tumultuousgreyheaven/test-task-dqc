# Скопируйте в .env (cp .env.example .env) и при необходимости поправьте.
# docker compose подхватывает .env автоматически.

# --- PostgreSQL ---
POSTGRES_DB=dqc
POSTGRES_USER=dqc
POSTGRES_PASSWORD=dqc_password
# порт БД на хосте (внутри сети compose всегда 5432)
POSTGRES_PORT=5432

# --- Приложение ---
# порт API на хосте
APP_PORT=8080
# профиль demo загружает стартовые данные и два прогона ККД при первом запуске
SPRING_PROFILES_ACTIVE=demo

# --- Миграции ---
# образ Liquibase (тег можно заменить на любой доступный 4.x)
LIQUIBASE_IMAGE=liquibase/liquibase:4.29.2

# --- Запуск приложения без Docker (mvn spring-boot:run) ---
# в compose эти переменные задаются автоматически из POSTGRES_*
# DB_URL=jdbc:postgresql://localhost:5432/dqc
# DB_USER=dqc
# DB_PASSWORD=dqc_password
# SERVER_PORT=8080
